# ─── AI PROVIDERS ───────────────────────────────────────────────────────────
# Writing (tailoring, cover letters, scoring, LinkedIn, interview prep, the
# Arabic purity pass) runs on core/llm_config.WRITING_MODEL. Extraction
# (cv_parser, jd_analyzer, fact_checker, the jobs_finder screener) is Gemini
# and is deliberately a different provider, so one outage cannot take down the
# whole pipeline.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional override for the writing model. Unset uses the default in
# core/llm_config.py (gpt-5.6-luna). Set it to claude-sonnet-5 to revert the
# whole writing migration from the dashboard without a deploy — the Anthropic
# path is kept and maintained for exactly that.
# WRITING_MODEL=gpt-5.6-luna

# Only needed if WRITING_MODEL names a Claude model.
ANTHROPIC_API_KEY=
# ─── JOB SEARCH PROVIDER ────────────────────────────────────────────────────
# One switch, both paths kept — core/search_provider.py. Env-overridable so a
# bad day can be rolled back from the Render dashboard without a deploy.
#   serper -> Google results via serper.dev. $0.001/search, 2,500 free/month.
#   tavily -> the previous provider. 2 credits/call at $0.008 = $0.016/call.
# SEARCH_PROVIDER=serper

SERPER_API_KEY=

# Only needed if SEARCH_PROVIDER=tavily.
TAVILY_API_KEY=
APP_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated list of allowed frontend origins for CORS (see main.py).
# Optional — if unset, falls back to the hardcoded production/dev defaults.
# ALLOWED_ORIGINS=https://tarshih.com,https://www.tarshih.com,http://localhost:3000

# ─── PAYMENTS / MOYASAR ─────────────────────────────────────────────────────
# Transport lives in core/moyasar_client.py. There is ONE gateway and one code
# path: core/payment_gateway.py and the mock gateway were retired in commit
# 5933c03, and PAYMENT_GATEWAY is no longer read by anything.
#
# ⚠️ WHAT MAKES PAYMENTS LIVE: the prefix on MOYASAR_SECRET_KEY, and nothing
# else. sk_test_ -> test mode, sk_live_ -> real money. There is no separate
# on/off switch to forget, and no mock mode that could accidentally ship.
#
# GOING LIVE, in order:
#   1. Moyasar Dashboard -> switch to Live, copy the live sk_ and pk_ keys.
#   2. Render:  MOYASAR_SECRET_KEY=sk_live_...
#               MOYASAR_PUBLISHABLE_KEY=pk_live_...
#               MOYASAR_MODE=live          (asserts the expectation, see below)
#               MOYASAR_WEBHOOK_SECRET=... (the LIVE webhook's secret — it is
#                                           a different one from the test
#                                           webhook, and reusing the test
#                                           value makes every live webhook
#                                           401 while payments still succeed)
#               PUBLIC_APP_URL=https://tarshih.com
#   3. Vercel:  NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=pk_live_...
#   4. Moyasar Dashboard -> Webhooks -> add the LIVE endpoint:
#               https://<render-host>/api/v1/webhooks/moyasar
#   5. Redeploy both. The backend logs its payment configuration at startup
#      (see core/moyasar_client.startup_report) — check that line says
#      mode=live and webhook_secret_set=True before taking a real payment.
#   6. Make one real purchase with a real card, then refund it from
#      /dashboard/admin/payments.
#
# THE KEYS MUST MATCH EACH OTHER. A live secret key with a test publishable
# key produces a form that tokenizes against test and a charge that settles
# against live; the startup report refuses to stay quiet about that.

# Secret key. BACKEND ONLY — never expose this, never prefix it with
# NEXT_PUBLIC_. Used as the HTTP Basic username with an EMPTY password.
# The real value starts with sk_test_ (test mode) or sk_live_ (live mode);
# left blank here on purpose, since a key-shaped placeholder trips GitHub's
# secret scanning and blocks the push.
# MOYASAR_SECRET_KEY=

# Publishable key (pk_). Public by design — the browser needs it to build the
# payment form. This backend copy exists only so the server can report which
# mode it is in; the browser reads NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY from
# frontend/.env.local instead. Keep the two in the same mode.
# The real value starts with pk_test_ or pk_live_.
# MOYASAR_PUBLISHABLE_KEY=

# Shared secret echoed back in every webhook body's `secret_token` field.
# Must be the EXACT value entered in Moyasar Dashboard → Webhooks. Unset
# means webhooks cannot be authenticated, and the receiver fails closed
# rather than trusting them. Generate one with:  openssl rand -hex 32
# MOYASAR_WEBHOOK_SECRET=

# Override only for testing against a mock/proxy. Defaults to the real API.
# MOYASAR_API_BASE=https://api.moyasar.com/v1

# test | live. Optional — normally inferred from the sk_test_/sk_live_ prefix
# on MOYASAR_SECRET_KEY. Set it explicitly to assert the expected mode in a
# deployment where the key is injected by a secret manager; a mismatch
# between this and the key prefix means the wrong keys are deployed.
# MOYASAR_MODE=test

# Where a hosted gateway returns the buyer after paying. Defaults to
# https://tarshih.com — set it locally so a test payment doesn't bounce you to
# production. Must be https:// in production.
# PUBLIC_APP_URL=http://localhost:3000

# ─── SUBSCRIPTION RENEWALS (see core/billing.py) ────────────────────────────
# Shared secret for POST /api/v1/billing/run-renewals, the daily job that
# charges saved cards. Must match the CRON_SECRET repository secret used by
# .github/workflows/billing-renewals.yml EXACTLY.
#
# Unset means the endpoint returns 503 and no renewal ever runs — which is
# the safe direction (nobody is charged), but it is silent, so check this
# before wondering why subscriptions are not renewing.
# Generate one with:  openssl rand -hex 32
# CRON_SECRET=

# ─── PREMIUM ORDER ALERTS (see core/linkedin_notify.py) ─────────────────────
# Premium LinkedIn orders are fulfilled by hand, so the backend emails the
# order details via Resend. Same key as the Supabase send-email function uses.
# Optional: with it unset, the order still lands in the admin fulfillment
# queue and the full details are written to the logs — nothing breaks.
# RESEND_API_KEY=
# EMAIL_FROM=Tarshih <noreply@tarshih.com>
# LINKEDIN_ORDER_ALERT_TO=support@tarshih.com