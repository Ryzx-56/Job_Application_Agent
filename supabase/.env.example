

# Resend API key — from resend.com dashboard -> API Keys
RESEND_API_KEY=

# The "From" address your confirmation emails will be sent as.
# Must use a domain you've verified in Resend.
EMAIL_FROM=Tarshih <noreply@yourdomain.com>

# Signing secret Supabase generates when you enable the "Send Email" hook
SEND_EMAIL_HOOK_SECRET=

# Your real public site URL, no trailing slash. Used to build confirmation
# links and the logo image URL — set explicitly rather than trusting
# Supabase's email_data.site_url, which can resolve to the project's own
# API base URL instead of your actual domain.
SITE_URL=https://tarshih.com
