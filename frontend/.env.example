# Frontend environment. Copy to .env.local for local development, and set the
# same values in the hosting provider's environment for production.
#
# NEXT_PUBLIC_* is compiled into the browser bundle and is PUBLIC by design.
# Never put a secret behind that prefix. In particular the Supabase
# service_role key must NEVER appear in this file or anywhere in frontend/ —
# it lives only in the backend's environment (see the root .env.example).

# ─── SUPABASE ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# The publishable/anon key. Safe to expose; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── BACKEND ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=

# ─── PAYMENTS (MOYASAR) ─────────────────────────────────────────────────────
# The publishable key (pk_). PUBLIC BY DESIGN — the hosted payment form runs
# in the browser and this key is what identifies the merchant to Moyasar. It
# can only create payments, never read or refund them.
#
# The SECRET key (sk_) must NEVER appear in this file, in any NEXT_PUBLIC_
# var, or anywhere under frontend/. It lives only in the backend environment
# (see the root .env.example).
#
# Keep this in the same mode as the backend's MOYASAR_SECRET_KEY — a pk_test_
# form posting against sk_live_ keys fails in a way that looks like a bug.
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=

# ─── ANALYTICS ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ─── LOGIN RATE LIMITING (server-side only, NOT NEXT_PUBLIC) ────────────────
# Used by app/api/auth/login/route.ts via lib/rate-limit.ts to throttle failed
# sign-in attempts per IP and per account.
#
# OPTIONAL. With these unset the limiter still works, but falls back to an
# in-process counter: each serverless instance counts separately and a cold
# start resets it, so the cap is soft. Set them and the limit becomes shared
# and durable across instances.
#
# Get them from an Upstash Redis database (the free tier is enough for this):
# https://console.upstash.com -> your database -> "REST API".
#
# If Upstash is unreachable at runtime the limiter degrades to the in-process
# counter rather than failing the request, so a Redis outage cannot take the
# login page down.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
